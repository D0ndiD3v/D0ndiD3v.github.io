---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'] & { readingTime?: number };

const { title, description, pubDate, updatedDate, heroImage, tags, readingTime } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				max-height: 70vh;
				width: auto;
				object-fit: contain;
				border-radius: 12px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
			}
			.prose {
				color: var(--color-text);
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--color-accent-secondary);
				font-family: 'IBM Plex Mono', monospace;
			}
			.reading-time {
				font-family: 'IBM Plex Mono', monospace;
			}
			.last-updated-on {
				font-style: italic;
			}
			:global(.margin-note) {
				font-family: 'Caveat', cursive;
				color: var(--color-accent-secondary);
				font-size: 2em;
				transform: rotate(-2deg);
				display: inline-block;
				margin: 0.5em 0;
			}
			.tags {
				display: flex;
				gap: 0.5em;
				justify-content: center;
				flex-wrap: wrap;
				margin-top: 0.5em;
			}
			.tag {
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.8rem;
				padding: 0.2em 0.6em;
				border: 1px solid var(--color-accent-secondary);
				border-radius: 4px;
				color: var(--color-accent-secondary);
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image src={heroImage} alt="" inferSize />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="date">
							<FormattedDate date={pubDate} />
							{readingTime && <span class="reading-time"> · {readingTime} min read</span>}
							{
								updatedDate && (
									<div class="last-updated-on">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1>{title}</h1>
						{tags && tags.length > 0 && (
							<div class="tags">
								{tags.map((tag: string) => <span class="tag">{tag}</span>)}
							</div>
						)}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>