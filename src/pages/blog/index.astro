---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Deterministic pseudo-random gradient per post, based on its id
function hashString(str: string) {
	let hash = 0;
	for (let i = 0; i < str.length; i++) {
		hash = (hash << 5) - hash + str.charCodeAt(i);
		hash |= 0;
	}
	return Math.abs(hash);
}

function fallbackGradient(id: string) {
	const h = hashString(id);
	const angle = h % 360;
	const colors = [
		'var(--color-accent-primary)',
		'var(--color-accent-secondary)',
		'var(--color-panel)',
	];
	const c1 = colors[h % colors.length];
	const c2 = colors[(h + 1) % colors.length];
	return `linear-gradient(${angle}deg, ${c1}, ${c2})`;
}
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			.mosaic {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				grid-auto-rows: 140px;
				gap: 1rem;
			}
			.mosaic li {
				list-style: none;
				border-radius: 12px;
				overflow: hidden;
				position: relative;
				background: var(--color-panel);
				border: 1px solid var(--color-border);
			}
			.mosaic li.large { grid-column: span 2; grid-row: span 2; }
			.mosaic li.wide { grid-column: span 2; grid-row: span 1; }
			.mosaic li.tall { grid-column: span 1; grid-row: span 2; }
			.mosaic li.small { grid-column: span 1; grid-row: span 1; }

			.mosaic a {
				display: block;
				height: 100%;
				width: 100%;
				text-decoration: none;
				position: relative;
			}
			.mosaic img {
				position: absolute;
				inset: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.4s ease;
			}
			.mosaic a:hover img {
				transform: scale(1.05);
			}
			.mosaic .caption {
				position: absolute;
				inset: 0;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: 1rem;
				background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, transparent 60%);
			}
			.mosaic .title {
				margin: 0;
				color: var(--color-text);
				font-family: 'Bricolage Grotesque', sans-serif;
				line-height: 1.15;
				font-size: 1rem;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.mosaic li.large .title { font-size: 1.4rem; }
			.mosaic li.wide .title { font-size: 1.15rem; }
			.mosaic li.tall .title { font-size: 1rem; }
			.mosaic li.small .title { font-size: 0.9rem; }
			.mosaic .date {
				margin: 0.25rem 0 0 0;
				color: var(--color-accent-secondary);
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.85rem;
			}
			.mosaic a:hover .title {
				color: var(--color-accent-primary);
			}

			@media (max-width: 720px) {
				.mosaic {
					grid-template-columns: repeat(2, 1fr);
					grid-auto-rows: 160px;
				}
				.mosaic li.large,
				.mosaic li.wide {
					grid-column: span 2;
				}
			}
			.mosaic .fallback-bg {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<ul class="mosaic">
				{
					posts.map((post) => (
						<li class={post.data.size}>
	<a href={`/blog/${post.id}/`}>
		{post.data.heroImage ? (
			<Image width={600} height={600} src={post.data.heroImage} alt="" />
		) : (
			<div class="fallback-bg" style={`background: ${fallbackGradient(post.id)};`} />
		)}
		<div class="caption">
			<h4 class="title">{post.data.title}</h4>
			<p class="date">
				<FormattedDate date={post.data.pubDate} />
			</p>
		</div>
	</a>
</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>